{
  "name": "boussole",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "gen": "node scripts/gen-catalogue.mjs && node scripts/gen-expertises-demo.mjs && node scripts/gen-police-separateur.mjs",
    "check:mcp": "npx -y deno check --config supabase/functions/mcp/deno.json supabase/functions/mcp/index.ts",
    "preprod:start": "node scripts/preprod/demarrer.mjs",
    "preprod:stop": "node scripts/preprod/cli.mjs stop",
    "preprod:reset": "node scripts/preprod/demarrer.mjs --reset",
    "preprod:sync": "node scripts/preprod/demarrer.mjs --sync",
    "preprod:test": "node scripts/preprod/tester.mjs",
    "preprod:seed": "node scripts/preprod/graine.mjs",
    "preprod:env": "node scripts/preprod/env.mjs",
    "preprod:fonctions": "node scripts/preprod/cli.mjs functions serve --env-file .preprod/fonctions.env",
    "preprod:app": "node build.mjs --config=preprod && node scripts/preprod/servir.mjs",
    "preprod:fumee": "node scripts/preprod/fumee.mjs",
    "preprod:connecteur": "node scripts/preprod/connecteur-mfa.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.7",
    "@supabase/supabase-js": "^2.117.2"
  }
}
